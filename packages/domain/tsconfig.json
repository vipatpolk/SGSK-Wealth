{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@sgsk-wealth/contracts": ["../contracts/src/index.ts"],
      "@sgsk-wealth/contracts/*": ["../contracts/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
