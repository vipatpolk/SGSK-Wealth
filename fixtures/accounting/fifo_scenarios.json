            "sellCount": 0,
            "exchangeCount": 0,
            "transactionCount": 2,
            "netShares": 100.0,
            "realizedPL": 0.0,
            "openLots": [
              { "purchaseDate": "2025-01-10", "quantity": 100.0, "costBasis": 30.0, "totalCost": 3000.0 }
            ],
            "closedLots": []
          }
        ]
      }
    },
    {
      "id": "multi-currency-conversion",
      "description": "USD and THB open positions convert consistently into THB and USD display currencies",
      "exchangeRateUsdToThb": 35.0,
      "transactions": [
        { "symbol": "AAPL", "date": "2025-01-10", "quantity": 10, "price": 100.0, "currency": "USD", "assetType": "us-stock", "txType": "BUY" },
        { "symbol": "PTT.BK", "date": "2025-01-12", "quantity": 100, "price": 35.0, "currency": "THB", "assetType": "thai-stock", "txType": "BUY" }
      ],
      "expected": {
        "tolerance": 1e-6,
        "totalCostInThb": 38500.0,
        "totalCostInUsd": 1100.0,
        "bySymbol": [
          {
            "symbol": "AAPL",
            "buyCount": 1,
            "sellCount": 0,
            "exchangeCount": 0,
            "transactionCount": 1,
            "netShares": 10.0,
            "realizedPL": 0.0,
            "openLots": [
              { "purchaseDate": "2025-01-10", "quantity": 10.0, "costBasis": 100.0, "totalCost": 1000.0 }
            ],
            "closedLots": []
          },
          {
            "symbol": "PTT.BK",
            "buyCount": 1,
            "sellCount": 0,
            "exchangeCount": 0,
            "transactionCount": 1,
            "netShares": 100.0,
            "realizedPL": 0.0,
            "openLots": [
              { "purchaseDate": "2025-01-12", "quantity": 100.0, "costBasis": 35.0, "totalCost": 3500.0 }
            ],
            "closedLots": []
          }
        ]
      }
    },
    {
      "id": "crypto-fractional-precision",
      "description": "Preserves 8-decimal fractional cryptocurrency precision without premature rounding",
      "exchangeRateUsdToThb": 35.0,
      "transactions": [
        { "symbol": "BTC.CRYPTO", "date": "2025-01-01", "quantity": 0.00012345, "price": 3000000.0, "currency": "THB", "assetType": "crypto", "txType": "BUY" },
        { "symbol": "BTC.CRYPTO", "date": "2025-02-01", "quantity": -0.00002345, "price": 3200000.0, "currency": "THB", "assetType": "crypto", "txType": "SELL" }
      ],
      "expected": {
        "tolerance": 1e-6,
        "bySymbol": [
          {
            "symbol": "BTC.CRYPTO",
            "buyCount": 1,
            "sellCount": 1,
            "exchangeCount": 0,
            "transactionCount": 2,
            "netShares": 0.0001,
            "realizedPL": 4.69,
            "openLots": [
              { "purchaseDate": "2025-01-01", "quantity": 0.0001, "costBasis": 3000000.0, "totalCost": 300.0 }
            ],
            "closedLots": [
              { "purchaseDate": "2025-01-01", "closeDate": "2025-02-01", "quantity": 0.00002345, "costBasis": 3000000.0, "sellPrice": 3200000.0, "realizedPL": 4.69 }
            ]
          }
        ]
      }
    }
  ],
  "csvScenarios": [
    {
      "id": "invalid-csv-rows-skipped",
      "description": "Skips zero quantity, NaN/non-numeric numbers, blank symbol, blank date, and short rows",
      "defaultAssetType": "us-stock",
      "csvText": "Symbol,Date,Quantity,Price,Currency,Asset Type,Transaction Type\nAAPL,2025-01-10,10,150.0,USD,us-stock,BUY\nZERO,2025-01-11,0,100.0,USD,us-stock,BUY\nNANP,2025-01-12,5,NaN,USD,us-stock,BUY\nBADQ,2025-01-13,abc,100.0,USD,us-stock,BUY\n,2025-01-14,5,100.0,USD,us-stock,BUY\nNODATE,,5,100.0,USD,us-stock,BUY\nSHORT,2025-01-15,5,100.0\nPTT.BK,2025-01-16,100,32.5,THB,thai-stock,BUY\n",
      "expectedSymbols": ["AAPL", "PTT.BK"]
    }
  ]
