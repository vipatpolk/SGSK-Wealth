<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sgsk.wealth</groupId>
    <artifactId>sgsk-wealth-mobile-android</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>SGSK Wealth Mobile Android (Capacitor + Maven)</name>
    <description>Maven build configuration for packaging the SGSK Wealth Ionic Capacitor Android APK</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <android.compileSdk>36</android.compileSdk>
        <android.minSdk>24</android.minSdk>
        <android.targetSdk>36</android.targetSdk>
        <android.buildType>debug</android.buildType>
        <androidx.activity.version>1.11.0</androidx.activity.version>
        <androidx.appcompat.version>1.7.0</androidx.appcompat.version>
        <androidx.coordinatorlayout.version>1.3.0</androidx.coordinatorlayout.version>
        <androidx.core.version>1.17.0</androidx.core.version>
        <androidx.fragment.version>1.8.9</androidx.fragment.version>
        <androidx.splashscreen.version>1.2.0</androidx.splashscreen.version>
        <androidx.webkit.version>1.14.0</androidx.webkit.version>
        <cordova.android.version>14.0.1</cordova.android.version>
    </properties>

    <repositories>
        <repository>
            <id>google-maven</id>
            <name>Google Android Repository</name>
            <url>https://dl.google.com/dl/android/maven2</url>
        </repository>
        <repository>
            <id>central</id>
            <name>Maven Central</name>
            <url>https://repo1.maven.org/maven2</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-android-root-artifacts</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/deps</outputDirectory>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>androidx.appcompat</groupId>
                                    <artifactId>appcompat</artifactId>
                                    <version>${androidx.appcompat.version}</version>
                                    <type>aar</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>androidx.core</groupId>
                                    <artifactId>core</artifactId>
                                    <version>${androidx.core.version}</version>
                                    <type>aar</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>androidx.activity</groupId>
                                    <artifactId>activity</artifactId>
                                    <version>${androidx.activity.version}</version>
                                    <type>aar</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>androidx.fragment</groupId>
                                    <artifactId>fragment</artifactId>
                                    <version>${androidx.fragment.version}</version>
                                    <type>aar</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>androidx.coordinatorlayout</groupId>
                                    <artifactId>coordinatorlayout</artifactId>
                                    <version>${androidx.coordinatorlayout.version}</version>
                                    <type>aar</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>androidx.webkit</groupId>
                                    <artifactId>webkit</artifactId>
                                    <version>${androidx.webkit.version}</version>
                                    <type>aar</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>androidx.core</groupId>
                                    <artifactId>core-splashscreen</artifactId>
                                    <version>${androidx.splashscreen.version}</version>
                                    <type>aar</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.cordova</groupId>
                                    <artifactId>framework</artifactId>
                                    <version>${cordova.android.version}</version>
                                    <type>aar</type>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>build-android-apk</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>node</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>scripts/build-apk.mjs</argument>
                                <argument>--compileSdk=${android.compileSdk}</argument>
                                <argument>--minSdk=${android.minSdk}</argument>
                                <argument>--targetSdk=${android.targetSdk}</argument>
                                <argument>--buildType=${android.buildType}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
