# ==============================================================================
# SGSK-Wealth Monorepo Environment Configuration Template
# Copy this file to `.env` at the repository root and fill in your values:
#   cp .env.example .env
#
# Full documentation: docs/operations/runbook.md
# ==============================================================================

# --- 1. Server & Runtime ------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# development | production (production enforces strict API keys, CORS & fail-closed auth)
ENVIRONMENT=development

# --- 2. Backend Security & CORS -----------------------------------------------
# In development, 'dev_secret_key_change_in_prod' matches the Angular proxy.
# In production, MUST be a high-entropy secret (>= 32 characters).
BACKEND_API_KEY=dev_secret_key_change_in_prod
# Optional secondary key accepted temporarily during zero-downtime key rotation (>= 32 chars if set).
BACKEND_API_KEY_PREVIOUS=
# JSON array or comma-separated origins (Capacitor native origins are preserved automatically).
ALLOWED_ORIGINS=["http://localhost:4200","http://localhost:4201","http://localhost","https://localhost","capacitor://localhost"]
# Legacy or direct backend hostnames blocked unless forwarded by the frontend gateway or signed with X-App-Source.
BLOCKED_DIRECT_HOSTS=["api-sgsk-wealth.vercel.app","sgsk-backend.vercel.app"]

# --- 3. Google Sheets (Owner Cloud Portfolio) ---------------------------------
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here
GOOGLE_PVD_SPREADSHEET_ID=your_google_pvd_spreadsheet_id_here
# Optional: path to a Google service account JSON file or raw JSON string (for private sheets).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
SHEETS_BASE_URL=https://docs.google.com/spreadsheets/d

# --- 4. Supabase Auth, Profile Authorization & Caching ------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Server-side admin key for Storage L2 icon caching (fallback alias: SUPABASE_SECRET_KEY).
SUPABASE_SERVICE_ROLE_KEY=
# Optional explicit JWKS URL override (defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json).
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Optional HS256 JWT secret for offline/legacy token verification.
SUPABASE_JWT_SECRET=
# Allowlisted owner email(s) for cloud portfolio endpoints (JSON array or CSV).
AUTHORIZED_PORTFOLIO_EMAILS=["owner@example.com"]

# --- 5. Thailand SEC Open Data APIs -------------------------------------------
# Register at https://api.sec.or.th to obtain your Ocp-Apim-Subscription-Key.
SEC_SUBSCRIPTION_KEY=your_sec_subscription_key_here
SEC_MF_BASE_URL=https://api.sec.or.th/v2/fund
SEC_PVD_BASE_URL=https://api.sec.or.th/v1/pvd

# --- 6. Market Data Upstreams (Optional Overrides) ----------------------------
YAHOO_BASE_URL=https://query1.finance.yahoo.com
YAHOO_FALLBACK_BASE_URL=https://query2.finance.yahoo.com
YFINANCE_TIMEOUT_SECONDS=10.0
YFINANCE_RETRIES=1
YFINANCE_MAX_CONCURRENCY=8
YFINANCE_DIVIDEND_PERIOD=max
YFINANCE_CACHE_DIR=
BINANCE_BASE_URL=https://api.binance.th
SET_TH_URL=https://weblink.set.or.th/dat/eod/listedcompany/static/listedCompanies_th_TH.xls
SET_EN_URL=https://weblink.set.or.th/dat/eod/listedcompany/static/listedCompanies_en_US.xls

# --- 7. Logo.dev Brand Icons (Optional) ---------------------------------------
# Obtain keys from https://www.logo.dev/docs/introduction (fallback alias: LOGO_DEV_TOKEN).
LOGO_DEV_PUBLISHABLE_KEY=pk_your_logo_dev_publishable_key_here
LOGO_DEV_SECRET_KEY=sk_your_logo_dev_secret_key_here
LOGO_DEV_IMG_BASE_URL=https://img.logo.dev
LOGO_DEV_API_BASE_URL=https://api.logo.dev

# --- 8. Vercel CLI / Local Development (Optional) -----------------------------
VERCEL_OIDC_TOKEN=
