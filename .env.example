# SGSK-Wealth Monorepo Environment Configuration Template
# Copy this file to .env at root level and fill in your values:
#   cp .env.example .env

# Runtime Environment (development | production)
ENVIRONMENT=development

# Backend Authentication API Key
# In development, use 'dev_secret_key_change_in_prod' to match frontend proxy
BACKEND_API_KEY=dev_secret_key_change_in_prod

# Allowed CORS Origins (JSON array of strings)
ALLOWED_ORIGINS=["http://localhost:4200"]

# SEC Open Data API (Thailand SEC API Portal)
# Register and subscribe at https://api.sec.or.th to obtain your subscription key
SEC_SUBSCRIPTION_KEY=your_sec_subscription_key_here

# Google Sheets Configuration
# Google Spreadsheet ID for portfolio transaction records
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# Google Spreadsheet ID for provident fund (PVD) transaction records
GOOGLE_PVD_SPREADSHEET_ID=your_google_pvd_spreadsheet_id_here

# Google Service Account Credentials (Optional, if sheets are private)
# Either a file path to the service account JSON or the raw JSON string
GOOGLE_SERVICE_ACCOUNT_JSON=

# SEC Provident Fund Endpoints
SEC_PVD_PROJ_ID=V0001_2553
SEC_PVD_BASE_URL=https://api.sec.or.th/v1/pvd
