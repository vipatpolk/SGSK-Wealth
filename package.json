{
  "name": "sgsk-wealth",
  "version": "1.0.0",
  "description": "SGSK-Wealth Monorepo - FastAPI Backend & Angular Frontend",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/vipatpolk/SGSK-Wealth.git"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:backend": "node scripts/dev.mjs --only=backend",
    "dev:frontend": "npm --prefix frontend start",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm --prefix frontend run test -- --watch=false",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "test:e2e:ui": "npm --prefix frontend run test:e2e:ui",
    "test:e2e:api": "npm --prefix frontend run test:e2e:api",
    "test:backend": "node scripts/dev.mjs --test-backend",
    "lint:backend": "node scripts/dev.mjs --lint-backend",
    "check": "npm run lint:backend && npm run test:backend && npm run test:frontend && npm run build"
  },
  "packageManager": "npm@11.10.1"
}
