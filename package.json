{
  "name": "sgsk-wealth",
  "version": "1.0.0",
  "description": "SGSK-Wealth Monorepo - Rust (Axum) Backend, Shared Domain & Contracts, Nuxt 4 Web SPA & Capacitor 8 Mobile Shell",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vipatpolk/SGSK-Wealth.git"
  },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:backend": "node scripts/dev.mjs --only=backend",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:frontend": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "build:web": "npm --prefix apps/web run build",
    "build:frontend": "npm --prefix apps/web run build",
    "generate:web": "npm --prefix apps/web run generate",
    "cap:sync": "npm run generate:web && node scripts/sync-nuxt-capacitor.mjs",
    "test": "npm run test:contracts && npm run test:domain && npm run test:tokens && npm run test:web && npm run test:backend && npm run test:crates",
    "test:contracts": "npm --prefix packages/contracts run test",
    "test:domain": "npm --prefix packages/domain run test",
    "test:tokens": "npm --prefix packages/design-tokens run test",
    "test:web": "npm --prefix apps/web run test",
    "test:frontend": "npm --prefix apps/web run test",
    "test:e2e": "node scripts/dev.mjs --e2e",
    "test:e2e:web": "node scripts/dev.mjs --e2e --tags=@web",
    "test:e2e:api": "node scripts/dev.mjs --e2e --tags=@api",
    "test:e2e:mobile": "node scripts/dev.mjs --e2e --tags=@mobile",
    "test:e2e:android": "node scripts/dev.mjs --e2e --tags=@android",
    "test:e2e:ios": "node scripts/dev.mjs --e2e --tags=@ios",
    "test:e2e:smoke": "node scripts/dev.mjs --e2e \"--tags=@smoke and not @mobile\"",
    "test:e2e:cross-platform": "mvn -f e2e/pom.xml test -Dcucumber.filter.tags=@cross-platform",
    "test:e2e:report": "mvn -f e2e/pom.xml allure:serve",
    "test:e2e:report:build": "mvn -f e2e/pom.xml allure:report",
    "test:backend": "node scripts/dev.mjs --test-backend",
    "lint:backend": "node scripts/dev.mjs --lint-backend",
    "lint:crates": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "test:crates": "cargo test --workspace",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "lint:gherkin": "node scripts/lint-gherkin.mjs",
    "lint:openapi": "node scripts/lint-openapi.mjs",
    "reconcile:api": "node scripts/reconcile-api.mjs",
    "reconcile:offline": "node scripts/reconcile-api.mjs --offline",
    "check:secrets": "node scripts/check-bundle-secrets.mjs",
    "setup:agents": "node scripts/setup-agents.mjs",
    "prepare": "node scripts/setup-agents.mjs",
    "check": "npm run lint:boundaries && npm run lint:gherkin && npm run lint:openapi && npm run test:contracts && npm run test:domain && npm run test:tokens && npm run lint:backend && npm run test:backend && npm run lint:crates && npm run test:crates && npm run test:web && npm run generate:web && npm run check:secrets"
  },
  "packageManager": "npm@11.10.1"
}
