{
  "name": "share-lot",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "cucumber-js",
    "test:e2e:ui": "cucumber-js --tags \"@ui\"",
    "test:e2e:api": "cucumber-js --tags \"@api\"",
    "test:e2e:smoke": "cucumber-js --tags \"@smoke\"",
    "test:e2e:report": "npx @serenity-js/html-reporter serve --dir ./reports/serenity-js --open",
    "test:e2e:summary": "node e2e/support/generate-summary.js",
    "clean:e2e": "node -e \"fs.rmSync('reports',{recursive:true,force:true});fs.rmSync('target',{recursive:true,force:true});fs.rmSync('playwright-report',{recursive:true,force:true});fs.rmSync('test-results',{recursive:true,force:true})\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.10.1",
  "dependencies": {
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/platform-browser-dynamic": "^22.1.1",
    "@angular/router": "^22.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@axe-core/playwright": "^4.10.1",
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.50.1",
    "@serenity-js/assertions": "^3.49.0",
    "@serenity-js/console-reporter": "^3.49.0",
    "@serenity-js/core": "^3.49.0",
    "@serenity-js/cucumber": "^3.49.0",
    "@serenity-js/html-reporter": "^3.49.0",
    "@serenity-js/playwright": "^3.49.0",
    "@serenity-js/web": "^3.49.0",
    "@tailwindcss/postcss": "^4.3.3",
    "jsdom": "^27.1.0",
    "pactum": "^3.9.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.0",
    "vitest": "^4.0.8"
  }
}
