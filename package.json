{
  "name": "sgsk-wealth",
  "version": "1.0.0",
  "description": "SGSK-Wealth Monorepo - FastAPI Backend & Angular Frontend",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/vipatpolk/SGSK-Wealth.git"
  },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:backend": "node scripts/dev.mjs --only=backend",
    "dev:frontend": "npm --prefix frontend start",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm --prefix frontend run test -- --watch=false",
    "test:e2e": "mvn -f e2e/pom.xml test",
    "test:e2e:ui": "mvn -f e2e/pom.xml test \"-Dcucumber.filter.tags=@ui\"",
    "test:e2e:api": "mvn -f e2e/pom.xml test \"-Dcucumber.filter.tags=@api\"",
    "test:e2e:smoke": "mvn -f e2e/pom.xml test \"-Dcucumber.filter.tags=@smoke\"",
    "test:e2e:report": "mvn -f e2e/pom.xml allure:serve",
    "test:backend": "node scripts/dev.mjs --test-backend",
    "lint:backend": "node scripts/dev.mjs --lint-backend",
    "lint:gherkin": "py .agent/skills/cucumber-bdd-best-practices/scripts/validate_gherkin.py --strict e2e/src/test/resources/features",
    "setup:agents": "node scripts/setup-agents.mjs",
    "prepare": "node scripts/setup-agents.mjs",
    "check": "npm run lint:gherkin && npm run lint:backend && npm run test:backend && npm run test:frontend && npm run build"
  },
  "packageManager": "npm@11.10.1"
}
