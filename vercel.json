{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "gh-pages": false
    }
  },
  "services": {
    "web": {
      "root": "web",
      "framework": "angular",
      "installCommand": "cd .. && npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist/sgsk-wealth",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "functions": {
        "api/**/*.rs": {
          "excludeFiles": "{tests/**,target/**}"
        }
      },
      "routes": [
        {
          "src": "^/api/backend(?:/(.*))?$",
          "transforms": [
            {
              "type": "request.headers",
              "op": "set",
              "target": {
                "key": "X-API-Key"
              },
              "args": "$BACKEND_API_KEY",
              "env": ["BACKEND_API_KEY"]
            }
          ],
          "continue": true
        },
        {
          "handle": "filesystem"
        },
        {
          "src": "^/api/backend(?:/(.*))?$",
          "dest": "/api/index"
        },
        {
          "src": "^/(.*)$",
          "dest": "/api/index"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/backend(/.*)?",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
